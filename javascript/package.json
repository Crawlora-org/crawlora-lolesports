{
  "name": "@crawlora-org/lolesports",
  "version": "0.1.0",
  "description": "Crawlora LoL Esports API client with 13 endpoints for leagues, schedules, live and completed events, teams, players, and game details",
  "homepage": "https://crawlora.net/?utm_source=npm&utm_medium=referral&utm_campaign=platform-clients&utm_content=lolesports-javascript-homepage",
  "bugs": { "url": "https://github.com/Crawlora-org/crawlora-lolesports/issues" },
  "keywords": ["crawlora", "api-client", "sdk", "web-scraping", "scraping-api", "lolesports", "lol-esports", "lolesports-api", "lol-esports-api", "lolesports-scraper", "lol-esports-scraper", "lolesports-data", "lol-esports-data", "lolesports-leagues", "lolesports-schedules", "lolesports-live-completed-events", "lolesports-teams", "lolesports-players", "lolesports-game-details"],
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": ["src", "README.md", "LICENSE"],
  "engines": { "node": ">=18" },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Crawlora-org/crawlora-lolesports",
    "directory": "javascript"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "typecheck": "tsc --noEmit",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "generate": "python3 ../scripts/generate.py"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
